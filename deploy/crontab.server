# =============================================
# Regime-Trader 云服务器定时任务（crontab）
# =============================================
# 部署位置：Linux 云服务器（Ubuntu），时区必须为 Asia/Shanghai
# 校验时区：timedatectl status | grep "Time zone"
#           若非 Asia/Shanghai，执行：
#             sudo timedatectl set-timezone Asia/Shanghai
#
# 前置依赖（一次性）：
#   cd /srv/regime-trader
#   python3 -m venv .venv
#   ./.venv/bin/pip install -r requirements.txt
#   ./.venv/bin/pip install ./wheels/AmazingData-1.1.9-cp314-none-any.whl ./wheels/tgw-1.0.9.2-py3-none-any.whl
#   配置 .env（拷贝本地 .env，含 MX_APIKEY/TGW_* 等）
#
# 使用方法：
#   crontab deploy/crontab.server     # 安装
#   crontab -l                        # 查看
#   crontab -r                        # 移除
#
# 注意：
#   - 所有命令都在项目根目录执行
#   - 日志由脚本自行写入 logs/<prefix>.log（含 _debug.log），cron 不重复重定向；
#     stdout 丢弃，仅 stderr（启动失败/未捕获异常）追加到 logs/cron_error.log
#   - flock 防止任务重入（节假日/周末趋势任务重叠等）
#   - trend_analysis 每交易日 15:10 收盘后（卖出规则基于当日收盘K线）；脚本内部无交易日判断，
#     cron 用 1-5 限定，法定节假日会多跑一次（产出空报告，无碍）；如需精确可留 1-5 即可
# =============================================

# ── 趋势跟踪分析：每交易日 15:10 收盘后（买入信号 + 持仓卖出信号，推送结果）──
10 15 * * 1-5 cd /srv/regime-trader && flock -n /tmp/trend.lock ./.venv/bin/python trend_analysis.py > /dev/null 2>> logs/cron_error.log

# ── ETF 周度观察 + 自动调仓：每周一 9:35（开盘后，妙想市价单可成交）──
35 9 * * 1 cd /srv/regime-trader && flock -n /tmp/etf.lock ./.venv/bin/python etf_observe.py --execute > /dev/null 2>> logs/cron_error.log

# ── 策略规划器（双 Agent + LLM 自进化）：已停用 2026-08-23（产出与初衷不符，代码留档复用）──
# 0 9 * * 6 cd /srv/regime-trader && flock -n /tmp/planner.lock ./.venv/bin/python strategy_planner.py > /dev/null 2>> logs/cron_error.log

# ── 风格状态周报（纯规则，无 LLM）：每周六 9:00 ──
# 回测验证标签质量后再启用（启用时删除行首 #）：
# 0 9 * * 6 cd /srv/regime-trader && flock -n /tmp/style.lock ./.venv/bin/python style_report.py > /dev/null 2>> logs/cron_error.log
